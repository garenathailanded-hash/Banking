{
  "name": "Account",
  "type": "object",
  "properties": {
    "owner_email": { "type": "string" },
    "customer_name": { "type": "string" },
    "account_number": { "type": "string" },
    "external_ref": { "type": "string" },
    "display_name": { "type": "string" },
    "account_type": { "type": "string", "enum": ["current", "savings", "fixed_deposit", "escrow"], "enumColors": ["blue", "green", "purple", "gray"] },
    "currency": { "type": "string", "default": "THB" },
    "balance": { "type": "number" },
    "available_balance": { "type": "number" },
    "daily_limit": { "type": "number" },
    "status": { "type": "string", "enum": ["active", "dormant", "frozen"], "enumColors": ["green", "gray", "red"] },
    "branch": { "type": "string" },
    "opened_at": { "type": "string" }
  },
  "required": ["owner_email", "account_number"],
  "rls": {
    "read": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "created_by_id": "{{user.id}}" },
    "update": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] }
  }
}
