{
  "name": "DocumentFile",
  "type": "object",
  "properties": {
    "owner_email": { "type": "string" },
    "filename": { "type": "string" },
    "stored_name": { "type": "string" },
    "file_url": { "type": "string" },
    "content_type": { "type": "string" },
    "size_bytes": { "type": "number" },
    "doc_type": { "type": "string", "enum": ["kyc", "statement", "payment_slip", "contract", "other"], "enumColors": ["blue", "purple", "yellow", "green", "gray"] },
    "verification_status": { "type": "string", "enum": ["pending", "verified", "rejected"], "enumColors": ["yellow", "green", "red"] }
  },
  "required": ["filename", "file_url"],
  "rls": {
    "read": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "created_by_id": "{{user.id}}" },
    "update": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] }
  }
}
